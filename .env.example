# Copy this file to .env and fill in ONE key. Never commit .env.

# Option A: Groq Cloud (fast, free tier) - https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Option B: Google Gemini (Best Use of Gemini API prize) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# If both keys are set, Groq is used unless you set this to "gemini".
# AI_PROVIDER=gemini
